-			int res;
-
-			writelog(dbc->log, LOG_DEBUG, "%s shutdown message %i of %i",
-				 (errno == EAGAIN ? "Resending" : "Sending"), i+1, *activethreads);
-			errno = 0;
-			res = mq_send(msgq, (char *) job, sizeof(parseJob_t), 1);
-			if( (res < 0) && (errno != EAGAIN) ) {
