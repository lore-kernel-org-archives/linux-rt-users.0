-unsigned int get_mqueue_msg_max(LogContext *log) {
-	FILE *fp = NULL;
-	char buf[130];
-	unsigned int msg_max = DEFAULT_MSG_MAX;
-
-	fp = fopen("/proc/sys/fs/mqueue/msg_max", "r");
