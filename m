-	// Prepare stdin, stdout and stderr for daemon mode
-	close(2);
-	close(1);
-	close(0);
-	i = open("/dev/null", O_RDWR); /* open stdin */
-	dup(i); /* stdout */
-	dup(i); /* stderr */
